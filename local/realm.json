{
  "realm": "slotkeeper",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "roles": {
    "realm": [
      {
        "name": "admin"
      }
    ]
  },
  "clients": [
    {
      "clientId": "slotkeeper",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "http://localhost:4321/*",
        "http://web:4321/*"
      ],
      "webOrigins": [
        "http://localhost:4321",
        "http://web:4321"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "slotkeeper",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "roles-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "true",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "alice",
      "enabled": true,
      "emailVerified": true,
      "firstName": "alice",
      "lastName": "Test",
      "email": "alice@example.invalid",
      "credentials": [
        {
          "type": "password",
          "value": "Local-test-2026!",
          "temporary": false
        }
      ],
      "realmRoles": []
    },
    {
      "username": "bob",
      "enabled": true,
      "emailVerified": true,
      "firstName": "bob",
      "lastName": "Test",
      "email": "bob@example.invalid",
      "credentials": [
        {
          "type": "password",
          "value": "Local-test-2026!",
          "temporary": false
        }
      ],
      "realmRoles": []
    },
    {
      "username": "admin",
      "enabled": true,
      "emailVerified": true,
      "firstName": "admin",
      "lastName": "Test",
      "email": "admin@example.invalid",
      "credentials": [
        {
          "type": "password",
          "value": "Local-test-2026!",
          "temporary": false
        }
      ],
      "realmRoles": [
        "admin"
      ]
    }
  ]
}
