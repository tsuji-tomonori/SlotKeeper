{
  "components": {
    "schemas": {
      "BookingInput": {
        "additionalProperties": false,
        "properties": {
          "end_at": {
            "format": "date-time",
            "title": "End At",
            "type": "string"
          },
          "purpose": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Purpose",
            "type": "string"
          },
          "resource_id": {
            "maxLength": 36,
            "minLength": 1,
            "title": "Resource Id",
            "type": "string"
          },
          "start_at": {
            "format": "date-time",
            "title": "Start At",
            "type": "string"
          }
        },
        "required": [
          "resource_id",
          "start_at",
          "end_at",
          "purpose"
        ],
        "title": "BookingInput",
        "type": "object"
      },
      "BusySlot": {
        "properties": {
          "end_at": {
            "format": "date-time",
            "title": "End At",
            "type": "string"
          },
          "label": {
            "default": "予約済み",
            "title": "Label",
            "type": "string"
          },
          "reservation": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Reservation"
              },
              {
                "type": "null"
              }
            ]
          },
          "start_at": {
            "format": "date-time",
            "title": "Start At",
            "type": "string"
          }
        },
        "required": [
          "start_at",
          "end_at"
        ],
        "title": "BusySlot",
        "type": "object"
      },
      "CancelInput": {
        "additionalProperties": false,
        "properties": {
          "version": {
            "minimum": 1.0,
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
          "version"
        ],
        "title": "CancelInput",
        "type": "object"
      },
      "Detail": {
        "properties": {
          "events": {
            "items": {
              "$ref": "#/components/schemas/Event"
            },
            "title": "Events",
            "type": "array"
          },
          "reservation": {
            "$ref": "#/components/schemas/Reservation"
          }
        },
        "required": [
          "reservation",
          "events"
        ],
        "title": "Detail",
        "type": "object"
      },
      "ErrorBody": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "request_id": {
            "title": "Request Id",
            "type": "string"
          }
        },
        "required": [
