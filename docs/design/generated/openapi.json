            "format": "date-time",
            "title": "End At",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "purpose": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Purpose",
            "type": "string"
          },
          "resource_id": {
            "maxLength": 36,
            "minLength": 1,
            "title": "Resource Id",
            "type": "string"
          },
          "start_at": {
            "format": "date-time",
            "title": "Start At",
            "type": "string"
          },
          "status": {
