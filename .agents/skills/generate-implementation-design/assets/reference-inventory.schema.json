{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "repository": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "source_root": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "enum": [
        "reference-blueprint",
        "target-adoption"
      ]
    },
    "file_count": {
      "type": "integer",
      "minimum": 1
    },
    "tree_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "requirement_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "blob_sha": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "classification": {
            "enum": [
              "static-checker",
              "as-built-generator",
              "common-io",
              "rule-engine",
              "e2e",
              "package-support"
            ]
          },
          "requirement_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "adoption": {
            "enum": [
              "adopt",
              "adapt",
              "extend",
              "not-adopted"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "language_assumptions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "connections": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0,
            "uniqueItems": true
          }
        },
        "required": [
          "path",
          "blob_sha",
          "purpose",
          "classification",
          "requirement_ids",
          "adoption",
          "reason",
          "language_assumptions",
          "connections"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "requirement_id": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "requirement_id",
          "reason"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "repository",
    "revision",
    "source_root",
    "scope",
    "file_count",
    "tree_sha256",
    "requirement_ids",
    "files",
    "gaps"
  ],
  "additionalProperties": false
}
